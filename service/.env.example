PORT=8080
ENV=development

DATABASE_URL=postgres://postgres:postgres@localhost:5432/quikram?sslmode=disable

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=720h

S3_ENDPOINT=
S3_BUCKET=quikram-files
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

LLM_PROVIDER=openai
LLM_ENDPOINT=https://api.openai.com/v1
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

FRONTEND_URL=http://localhost:3000
